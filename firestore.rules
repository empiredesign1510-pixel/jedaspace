rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().data.active == true
        && userProfile().data.role in ['admin', 'barista'];
    }

    function isAdmin() {
      return activeStaff() && userProfile().data.role == 'admin';
    }

    function validTableToken() {
      let tokenPath = /databases/$(database)/documents/tableTokens/$(request.resource.data.tableToken);
      return exists(tokenPath)
        && get(tokenPath).data.active == true
        && get(tokenPath).data.tableId == request.resource.data.tableId
        && get(tokenPath).data.tableNumber == request.resource.data.tableNumber;
    }

    function validOrderCreate() {
      return request.resource.data.keys().hasOnly([
          'orderNumber', 'tableId', 'tableNumber', 'tableName', 'tableToken',
          'status', 'paymentStatus', 'subtotal', 'discount', 'total',
          'customerNote', 'cancelReason', 'idempotencyKey', 'schemaVersion',
          'items', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() >= 10
        && request.resource.data.orderNumber.size() <= 40
        && request.resource.data.tableId is string
        && request.resource.data.tableNumber is string
        && request.resource.data.tableToken is string
        && request.resource.data.tableToken.size() >= 16
        && validTableToken()
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.discount == 0
        && request.resource.data.total == request.resource.data.subtotal
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.idempotencyKey is string
        && request.resource.data.idempotencyKey.size() >= 20
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validOrderTransition(oldStatus, newStatus) {
      return oldStatus == newStatus
        || (oldStatus == 'pending' && newStatus in ['accepted', 'cancelled'])
        || (oldStatus == 'accepted' && newStatus in ['preparing', 'cancelled'])
        || (oldStatus == 'preparing' && newStatus in ['ready', 'cancelled'])
        || (oldStatus == 'ready' && newStatus in ['completed', 'cancelled']);
    }

    function validPaymentTransition(oldPayment, newPayment) {
      return oldPayment == newPayment
        || (oldPayment == 'unpaid' && newPayment == 'paid')
        || (isAdmin() && oldPayment == 'paid' && newPayment == 'refunded');
    }

    function validStaffOrderUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return activeStaff()
        && changed.hasOnly(['status', 'paymentStatus', 'paymentUpdatedBy', 'cancelReason', 'updatedAt'])
        && validOrderTransition(resource.data.status, request.resource.data.status)
        && validPaymentTransition(resource.data.paymentStatus, request.resource.data.paymentStatus)
        && (request.resource.data.status != 'cancelled' || request.resource.data.cancelReason.size() > 0)
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow get, list: if activeStaff() || resource.data.active == true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /menu/{menuId} {
      allow get, list: if activeStaff() || resource.data.active == true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (activeStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available', 'updatedAt'])
          && request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    match /tables/{tableId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /tableTokens/{token} {
      allow get: if isAdmin() || resource.data.active == true;
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/public {
      allow get: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /orders/{orderId} {
      // Customer follows a specific random order document ID as a bearer token.
      // Collection listing remains staff-only.
      allow get: if true;
      allow list: if activeStaff();
      allow create: if validOrderCreate();
      allow update: if validStaffOrderUpdate();
      allow delete: if false;

      match /history/{historyId} {
        allow read: if activeStaff();
        allow create: if activeStaff()
          && request.resource.data.changedBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
